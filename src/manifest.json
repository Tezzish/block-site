{
  "manifest_version": 2,
  "name": "Website Blocker",
  "version": "0.0",
  "description": "Blocks specified websites.",
  "permissions": [
    "activeTab",
    "alarms",
    "storage",
    "webRequest",
    "webRequestBlocking",
    "downloads",
    "contextMenus",
    "<all_urls>"
  ],
  "content_security_policy": "script-src 'self'; object-src 'self'",
  "background": {
    "scripts": [
      "background.js"
    ],
    "type": "module"
  },
  "browser_action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "48": "icons/48.png"
    }
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "{6f74d64f-379d-4197-8e13-b264b28dff85}"
    }
  },
  "icons": {
    "48": "assets/Logo-badge.png"
  },
  "web_accessible_resources": [
    "content/blocked.html"
  ],
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  }
}
